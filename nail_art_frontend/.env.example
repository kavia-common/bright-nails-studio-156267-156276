# Frontend (Create React App)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_SITE_URL=http://localhost:3000

# Server (Node/Nodemailer) - keep these secrets OUT of the frontend!
# Do NOT prefix with REACT_APP_. These are used only by server/index.js
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_account@gmail.com
SMTP_PASS=your_gmail_app_password   # Use a Gmail App Password (not your normal password)
ADMIN_EMAIL=your_gmail_account@gmail.com
SITE_URL=http://localhost:3000
PORT=4000
