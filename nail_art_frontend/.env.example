# Copy to .env and fill with your project values

# Supabase project URL (Project Settings > API > Project URL)
REACT_APP_SUPABASE_URL=

# Supabase anon public key (Project Settings > API > anon public)
REACT_APP_SUPABASE_ANON_KEY=

# Site URL used for auth redirects (must match Authentication > URL Configuration)
# For local dev, keep http://localhost:3000
REACT_APP_SITE_URL=http://localhost:3000

# Optional: Instagram handle for the IG link component
# REACT_APP_INSTAGRAM_USERNAME=brightnails
