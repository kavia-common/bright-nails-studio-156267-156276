# Copy this file to .env and fill in the values for your Supabase project.

# Supabase Project URL (Project Settings > API > Project URL)
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon public API key (Project Settings > API > anon public)
REACT_APP_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Site URL used for auth redirects (dev: http://localhost:3000)
REACT_APP_SITE_URL=http://localhost:3000

# Optional: Public Instagram handle (for profile link)
# REACT_APP_INSTAGRAM_USERNAME=brightnailsstudio
